# ==============================================================================
# User Directory — Variables de Entorno y Configuración de API
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto:
#   cp .env.example .env
# NUNCA subas tu archivo `.env` al repositorio de Git.

# URL del endpoint de usuarios de JSONPlaceholder (Público y Gratuito)
VITE_API_URL=https://jsonplaceholder.typicode.com/users

# NOTA SOBRE CREDENCIALES:
# JSONPlaceholder (https://jsonplaceholder.typicode.com) es una API REST pública
# para prototipado y pruebas. No requiere ningún tipo de token, clave o autenticación.
